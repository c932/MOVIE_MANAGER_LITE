[Unit]
Description=Movie Wall read-only SMB connection helper
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/usr/bin/python3.11 /usr/local/libexec/movie-wall-nas-helper.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=multi-user.target
