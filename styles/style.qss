/*
全局 QSS 样式表
现代化鲜艳主题 (Modern Vibrant Theme)
设计理念：层次感、呼吸感、高交互反馈
*/

/* =========================== 全局默认样式 =========================== */
* {
    font-family: "Microsoft YaHei", "Segoe UI", "SF Pro Display", Arial, sans-serif;
}

/* =========================== 主窗口 =========================== */
QMainWindow {
    background-color: #F4F5F7;  /* 浅灰背景，拉开层次 */
}

/* =========================== 左侧过滤面板 =========================== */
#FilterPanel {
    background-color: #FFFFFF;  /* 纯白卡片感 */
}

#FilterScrollArea {
    background-color: #FFFFFF;
    border-right: 1px solid #E8EAED;
    border: none;
}

#FilterScrollArea QScrollBar:vertical {
    background-color: #F8F9FA;
    width: 10px;
    margin: 0px;
    border: none;
}

#FilterScrollArea QScrollBar::handle:vertical {
    background-color: #CED4DA;
    min-height: 30px;
    border-radius: 5px;
}

#FilterScrollArea QScrollBar::handle:vertical:hover {
    background-color: #ADB5BD;
}

#FilterScrollArea QScrollBar::add-line:vertical,
#FilterScrollArea QScrollBar::sub-line:vertical {
    height: 0px;
}

#FilterScrollArea QScrollBar::add-page:vertical,
#FilterScrollArea QScrollBar::sub-page:vertical {
    background: none;
}

#GameFilterFooter {
    background-color: #FFFFFF;
    border-top: 1px solid #E8EAED;
}

/* 过滤按钮样式 */
#FilterButton {
    background-color: #FFFFFF;
    color: #5F6368;
    border: 2px solid #E8EAED;
    border-radius: 16px;
    padding: 10px 16px;
    text-align: left;
    font-size: 13px;
}

#FilterButton:hover {
    background-color: #F8F9FA;
    border-color: #007AFF;
    color: #007AFF;
}

#FilterButton:checked {
    background-color: #007AFF;
    color: #FFFFFF;
    border-color: #007AFF;
    font-weight: bold;
}

/* 重置筛选按钮 */
#ResetButton {
    background-color: #FFFFFF;
    color: #007AFF;
    border: 2px solid #007AFF;
    border-radius: 12px;
    font-weight: bold;
    padding: 10px;
}

#ResetButton:hover {
    background-color: #007AFF;
    color: #FFFFFF;
}

#ResetButton:pressed {
    background-color: #0051D5;
}

/* 排序按钮 */
#SortButton {
    background-color: #F8F9FA;
    color: #495057;
    border: 1px solid #DEE2E6;
    border-radius: 6px;
    padding: 6px 12px;
    font-size: 11px;
}

#SortButton:hover {
    background-color: #E9ECEF;
    border-color: #007AFF;
    color: #007AFF;
}

#SortButton:checked {
    background-color: #007AFF;
    color: #FFFFFF;
    border-color: #007AFF;
    font-weight: bold;
}

/* 刷新媒体库按钮 */
#RefreshButton {
    background-color: #28A745;
    color: #FFFFFF;
    border: none;
    border-radius: 10px;
    padding: 10px;
    font-size: 12px;
}

#RefreshButton:hover {
    background-color: #218838;
}

#RefreshButton:pressed {
    background-color: #1E7E34;
}

/* 媒体库设置按钮 */
#SettingsButton {
    background-color: #007AFF;
    color: #FFFFFF;
    border: none;
    border-radius: 12px;
    padding: 12px;
    font-size: 13px;
}

#SettingsButton:hover {
    background-color: #0051D5;
}

#SettingsButton:pressed {
    background-color: #003DA5;
}

/* =========================== 右侧内容区域 =========================== */
#RightContent {
    background-color: #F4F5F7;  /* 与主背景一致 */
}

/* 状态标签 */
#StatusLabel {
    color: #5F6368;
    font-size: 14px;
    padding: 8px 0;
}

/* 进度条 */
#ProgressBar {
    border: none;
    border-radius: 10px;
    text-align: center;
    background-color: #E8EAED;
    color: #333333;
    font-size: 12px;
    font-weight: bold;
    height: 20px;
}

#ProgressBar::chunk {
    background-color: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #007AFF,
        stop:1 #00D9FF
    );
    border-radius: 10px;
}

/* 海报墙滚动区域 */
#PosterScrollArea {
    border: none;
    background-color: transparent;
}

/* 海报墙容器 */
#PosterWall {
    background-color: transparent;
}

/* =========================== 海报卡片 =========================== */
#MovieCard, #GameCard {
    background-color: #FFFFFF;
    border-radius: 12px;
    border: 2px solid transparent;
    padding: 12px;
}

#MovieCard:hover, #GameCard:hover {
    border: 2px solid #007AFF;
}

/* =========================== 空状态按钮 =========================== */
#AddLibraryButton {
    background-color: #007AFF;
    color: #FFFFFF;
    border: none;
    border-radius: 14px;
    font-size: 15px;
    padding: 18px 35px;
}

#AddLibraryButton:hover {
    background-color: #0051D5;
}

#AddLibraryButton:pressed {
    background-color: #003DA5;
}

/* =========================== 滚动条样式 =========================== */
QScrollBar:vertical {
    border: none;
    background-color: #F4F5F7;
    width: 14px;
    margin: 0px;
    border-radius: 7px;
}

QScrollBar::handle:vertical {
    background-color: #D0D3D8;
    border-radius: 7px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #007AFF;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    border: none;
    background-color: #F4F5F7;
    height: 14px;
    margin: 0px;
    border-radius: 7px;
}

QScrollBar::handle:horizontal {
    background-color: #D0D3D8;
    border-radius: 7px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #007AFF;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* =========================== 对话框 =========================== */
QDialog {
    background-color: #FFFFFF;
}

/* =========================== 工具提示 =========================== */
QToolTip {
    background-color: #1C1C1E;
    color: #FFFFFF;
    border: 1px solid #007AFF;
    padding: 8px 12px;
    border-radius: 8px;
    font-size: 12px;
}

/* =========================== 消息框 =========================== */
QMessageBox {
    background-color: #FFFFFF;
}

QMessageBox QLabel {
    color: #1C1C1E;
    font-size: 13px;
    padding: 10px;
}

QMessageBox QPushButton {
    background-color: #007AFF;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 8px 24px;
    font-weight: bold;
    min-width: 80px;
    font-size: 13px;
}

QMessageBox QPushButton:hover {
    background-color: #0051D5;
}

QMessageBox QPushButton:pressed {
    background-color: #003DA5;
}

/* =========================== 通用按钮样式 =========================== */
QPushButton {
    outline: none;
}

QPushButton:focus {
    outline: none;
}

/* =========================== 详情对话框特殊样式 =========================== */
/* 播放按钮等特殊元素在各自文件中定义内联样式 */

/* 桌面刮削工作台：仅作用于两个刮削窗口，主题由 QApplication 统一加载。 */
QDialog#scrapeDialog, QDialog#scrapeSettingsDialog {
    background-color: #F4F5F7;
    font-family: "Microsoft YaHei", "Segoe UI";
    font-size: 12px;
    color: #1C1C1E;
}
QDialog#scrapeDialog QLabel#scrapeHeading,
QDialog#scrapeSettingsDialog QLabel#scrapeHeading {
    font-size: 20px;
    font-weight: bold;
}
QDialog#scrapeDialog QLabel#scrapeSection {
    font-size: 13px;
    font-weight: bold;
    padding: 4px 0;
}
QDialog#scrapeDialog QLabel#scrapeHint,
QDialog#scrapeSettingsDialog QLabel#scrapeHint {
    color: #63666C;
    padding: 4px;
}
QDialog#scrapeDialog QLabel#scrapeWarning {
    color: #9A4800;
    background-color: #FFF3E3;
}
QDialog#scrapeDialog QLabel#scrapeStatus {
    padding: 5px 8px;
    color: #333333;
}
QDialog#scrapeDialog QScrollArea,
QDialog#scrapeSettingsDialog QScrollArea {
    border: none;
    background-color: #FFFFFF;
}
QDialog#scrapeDialog QWidget#scrapeBody {
    background-color: #FFFFFF;
}
QDialog#scrapeDialog QListWidget,
QDialog#scrapeDialog QPlainTextEdit {
    border: 1px solid #D0D3D8;
    border-radius: 6px;
    background-color: #FFFFFF;
    color: #1C1C1E;
    padding: 5px;
}
QDialog#scrapeDialog QListWidget::item {
    padding: 7px 4px;
    border-radius: 4px;
}
QDialog#scrapeDialog QListWidget::item:selected {
    background-color: #E3F2FD;
    color: #0051D5;
}
QDialog#scrapeDialog QLineEdit, QDialog#scrapeDialog QComboBox,
QDialog#scrapeSettingsDialog QLineEdit, QDialog#scrapeSettingsDialog QComboBox,
QDialog#scrapeSettingsDialog QSpinBox, QDialog#scrapeSettingsDialog QDoubleSpinBox {
    min-height: 26px;
    border: 1px solid #D0D3D8;
    border-radius: 5px;
    background-color: #FFFFFF;
    padding: 2px 5px;
}
QDialog#scrapeDialog QPushButton, QDialog#scrapeSettingsDialog QPushButton {
    min-height: 28px;
    padding: 2px 10px;
    border: 1px solid #D0D3D8;
    border-radius: 6px;
    background-color: #FFFFFF;
    color: #333333;
}
QDialog#scrapeDialog QPushButton#scrapePrimary,
QDialog#scrapeSettingsDialog QPushButton#scrapePrimary {
    background-color: #007AFF;
    border-color: #007AFF;
    color: #FFFFFF;
    font-weight: bold;
}
QDialog#scrapeDialog QPushButton:hover, QDialog#scrapeSettingsDialog QPushButton:hover {
    border-color: #007AFF;
}
QDialog#scrapeDialog QPushButton:disabled, QDialog#scrapeSettingsDialog QPushButton:disabled,
QDialog#scrapeDialog QPushButton#scrapePrimary:disabled,
QDialog#scrapeSettingsDialog QPushButton#scrapePrimary:disabled {
    color: #85898F;
    background-color: #E7E9ED;
    border-color: #D0D3D8;
}
QDialog#scrapeDialog QPushButton:focus, QDialog#scrapeSettingsDialog QPushButton:focus,
QDialog#scrapeDialog QLineEdit:focus, QDialog#scrapeSettingsDialog QLineEdit:focus,
QDialog#scrapeDialog QComboBox:focus, QDialog#scrapeSettingsDialog QComboBox:focus {
    border: 2px solid #0051D5;
}

/* 独立资料管理区域：只作用于刮削管理、搜索、编辑，电影墙不受影响。 */
QDialog#scrapeManager, QDialog#scrapeSearchDialog, QDialog#metadataEditor {
    background: #F3F4F5;
    color: #25313B;
    font-family: "Microsoft YaHei", "Segoe UI";
    font-size: 12px;
}
QDialog#scrapeManager QWidget#managementToolbar {
    background: #30343A;
}
QDialog#scrapeManager QPushButton, QDialog#scrapeManager QToolButton,
QDialog#scrapeSearchDialog QPushButton, QDialog#metadataEditor QPushButton {
    background: #FFFFFF;
    color: #25313B;
    border: 1px solid #BFC7CE;
    border-radius: 3px;
    padding: 5px 12px;
    min-height: 24px;
}
QDialog#scrapeManager QWidget#managementToolbar QPushButton {
    background: #3E444C;
    color: #F7F9FB;
    border: 1px solid #535D68;
    padding: 7px 14px;
}
QDialog#scrapeManager QPushButton:hover, QDialog#scrapeManager QToolButton:hover,
QDialog#scrapeSearchDialog QPushButton:hover, QDialog#metadataEditor QPushButton:hover {
    border-color: #2473B8;
    background: #E7F1FA;
    color: #174F7D;
}
QDialog#scrapeManager QPushButton:disabled, QDialog#scrapeSearchDialog QPushButton:disabled,
QDialog#metadataEditor QPushButton:disabled {
    background: #E4E7EB;
    color: #7C848D;
    border-color: #CDD3D9;
}
QDialog#scrapeManager QLineEdit, QDialog#scrapeManager QComboBox,
QDialog#scrapeSearchDialog QLineEdit, QDialog#scrapeSearchDialog QComboBox,
QDialog#metadataEditor QLineEdit, QDialog#metadataEditor QSpinBox {
    background: #FFFFFF;
    color: #25313B;
    border: 1px solid #BFC7CE;
    border-radius: 2px;
    min-height: 25px;
    padding: 2px 5px;
}
QDialog#scrapeManager QLineEdit:focus, QDialog#scrapeManager QComboBox:focus,
QDialog#scrapeSearchDialog QLineEdit:focus, QDialog#metadataEditor QLineEdit:focus,
QDialog#scrapeSearchDialog QPushButton:focus, QDialog#metadataEditor QPushButton:focus,
QDialog#scrapeManager QPushButton:focus {
    border: 2px solid #2473B8;
}
QDialog#scrapeManager QTableView, QDialog#scrapeSearchDialog QTableWidget,
QDialog#metadataEditor QTableWidget {
    background: #FFFFFF;
    alternate-background-color: #F4F6F8;
    color: #25313B;
    gridline-color: #DDE2E7;
    border: 1px solid #CFD6DD;
    selection-background-color: #D5E7F5;
    selection-color: #133D5E;
    font-size: 12px;
}
QDialog#scrapeManager QHeaderView::section,
QDialog#scrapeSearchDialog QHeaderView::section,
QDialog#metadataEditor QHeaderView::section {
    background: #E9EDF0;
    color: #52606B;
    border: none;
    border-right: 1px solid #CFD6DD;
    border-bottom: 1px solid #CFD6DD;
    padding: 6px 5px;
    font-size: 12px;
}
QDialog#scrapeManager QWidget#managementInspector {
    background: #FFFFFF;
}
QDialog#scrapeManager QLabel#managementMovieTitle {
    font-size: 21px;
    font-weight: bold;
    padding: 2px 0 4px 0;
}
QDialog#scrapeManager QLabel#managementScore {
    font-size: 21px;
    font-weight: bold;
    padding: 4px;
}
QDialog#scrapeManager QLabel#managementPoster, QDialog#scrapeSearchDialog QLabel#managementPoster,
QDialog#metadataEditor QLabel#managementPoster {
    background: #E7EBEF;
    color: #788591;
    border: 1px solid #D4DBE2;
}
QDialog#scrapeManager QTextBrowser, QDialog#scrapeManager QPlainTextEdit,
QDialog#scrapeSearchDialog QPlainTextEdit, QDialog#metadataEditor QPlainTextEdit {
    background: #FFFFFF;
    border: 1px solid #DBE1E7;
    border-radius: 2px;
    color: #344653;
    padding: 7px;
}
QDialog#scrapeManager QWidget#managementFooter {
    background: #E9EDF0;
    border-top: 1px solid #D0D7DF;
}
QDialog#scrapeManager QTabBar::tab, QDialog#scrapeSearchDialog QTabBar::tab,
QDialog#metadataEditor QTabBar::tab {
    background: #E5E9ED;
    color: #566371;
    padding: 7px 14px;
    border: 1px solid #D1D8DF;
}
QDialog#scrapeManager QTabBar::tab:selected, QDialog#scrapeSearchDialog QTabBar::tab:selected,
QDialog#metadataEditor QTabBar::tab:selected {
    background: #FFFFFF;
    color: #155D98;
    border-bottom: 2px solid #2473B8;
}
QDialog#scrapeManager QSplitter::handle, QDialog#scrapeSearchDialog QSplitter::handle {
    background: #CFD6DD;
    width: 5px;
}
QDialog#scrapeSearchDialog QPushButton#scrapePrimary, QDialog#metadataEditor QPushButton#scrapePrimary {
    background: #2473B8;
    color: #FFFFFF;
    border-color: #2473B8;
}
QDialog#scrapeSearchDialog QPushButton#scrapePrimary:disabled, QDialog#metadataEditor QPushButton#scrapePrimary:disabled {
    background: #D8DFE6;
    color: #7C848D;
    border-color: #CDD3D9;
}

